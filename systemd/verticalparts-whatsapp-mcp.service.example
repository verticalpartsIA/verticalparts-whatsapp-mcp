[Unit]
Description=VerticalParts WhatsApp MCP
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/verticalparts-whatsapp-mcp
EnvironmentFile=/opt/verticalparts-whatsapp-mcp/.env
ExecStart=/opt/verticalparts-whatsapp-mcp/.venv/bin/python -m verticalparts_whatsapp_mcp.server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
