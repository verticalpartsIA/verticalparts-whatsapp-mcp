# Evolution API (instância corporativa já existente — nunca gerar uma nova sem coordenar)
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=pv360

# MCP
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8010

# Segurança/auditoria
WHATSAPP_MCP_AUDIT_LOG=./data/audit.jsonl
WHATSAPP_MCP_ALLOW_WRITES=false

# Gateway de eventos (canal "gatilho de sistema" -- VP Click, Requisições, Pós-Venda, Borderô)
EVENTS_HOST=127.0.0.1
EVENTS_PORT=8011
EVENTS_DB_PATH=./data/events.sqlite3
EVENTS_SYSTEMS_FILE=./config/systems.yaml
EVENTS_TEMPLATES_FILE=./config/templates.yaml
